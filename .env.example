# --- required for a live bake-off call ---
# Bland includes telephony in the API (signup credits, no Twilio account).
# https://app.bland.ai
BLAND_API_KEY=

# --- ElevenLabs parallel availability calls (`cityx check --live`) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_3801m5571nj3f938ke1v1p3rxys2
ELEVENLABS_PHONE_NUMBER_ID=phnum_1501m5577ynnfy69pt6vqv9xbknm

# --- web app (`cityx serve`) ---
# Parses the user's request into city/dates/guests/budget
OPENAI_API_KEY=
PARSE_MODEL=gpt-5.4-mini
# SearchAPI.io Google Hotels (stays + prices + phones). Unset in demo mode = built-in fixture hotels.
SEARCHAPI_API_KEY=
# Leave unset for demo mode (no calls, no email). 1 = place real calls and send email.
LIVE_CALLS=

# --- hackathon team number, used in the email subject ---
TEAM_NUMBER=8

# --- guest / receipt (judges will give the email at go-time) ---
GUEST_NAME=Rupinder
GUEST_PHONE=+14165550100
RECEIPT_EMAIL=judges@example.com
GUEST_CARD_NOTE=Guarantee with a credit card at check-in if asked.

# --- stay defaults (override on the CLI) ---
CITY=
CHECK_IN=2026-10-18
CHECK_OUT=2026-10-19
ADULTS=1
CURRENCY=CAD


# --- optional: skip search and dial a planted front-desk number ---
HOTEL_PHONE=

# --- optional Amadeus test sandbox for live rates (free signup) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# --- optional: watch Gmail/IMAP for the receipt in parallel ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# --- emailing booking details (`cityx check --notify you@example.com`) ---
# Gmail app password; falls back to IMAP_USER / IMAP_PASSWORD above
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=

# --- optional LLM to parse messy call transcripts (Groq free tier) ---
GROQ_API_KEY=

# dry_run never dials; bland places a real PSTN call
VOICE_PROVIDER=bland
MAX_HOTELS_TO_TRY=5

# --- test mode for live runs: dial at most CALL_LIMIT hotels, at CALL_PHONE_OVERRIDE if set ---
CALL_LIMIT=
CALL_PHONE_OVERRIDE=
